# Secrets only. Everything else is set on the dashboard.
# Keep this file private: chmod 600 .env
DISCORD_TOKEN=
# Optional. Set it to sign in with Discord's own button. Without it, people sign in with the bot's /dashboard command.
DISCORD_CLIENT_SECRET=
# 32 random bytes, base64. Create one with: python -m captainguild.keygen
# Losing this key makes the database unreadable, so back it up on its own.
MASTER_KEY=
# Optional. A key from dash.fortnite-api.com turns on the fortnite command. Without it, that command says the host hasn't added one.
FORTNITE_API_KEY=
